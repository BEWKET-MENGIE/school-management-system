datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  TEACHER
  STUDENT
  PARENT
  ACCOUNTANT
}

enum StudentStatus {
  ACTIVE
  GRADUATED
  TRANSFERRED_OUT
  SUSPENDED
}

enum TeacherStatus {
  ACTIVE
  TRANSFERRED_OUT
  ON_LEAVE
}

enum AttendanceType {
  PERIOD
  GATE_CHECKIN
  GATE_CHECKOUT
  HALL_PASS
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum HallPassStatus {
  NONE
  ACTIVE
  EXPIRED
  RETURNED
}

enum AssessmentType {
  HOMEWORK
  QUIZ
  CLASSWORK
  MIDTERM
  FINAL
  PROJECT
}

enum ExamType {
  QUIZ
  ASSIGNMENT
  MIDTERM
  FINAL
}

enum PromotionStatus {
  PROMOTED
  RETAINED
  CONDITIONALLY_PROMOTED
  PENDING
}

enum TransferType {
  INCOMING
  OUTGOING
}

enum Stream {
  NONE // Added to match @default(NONE) in StudentEnrollment
  GENERAL // For Grades 9 and 10
  NATURAL_SCIENCE // For Grades 11 and 12
  SOCIAL_SCIENCE // For Grades 11 and 12
}

enum FeeStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  CHECK
}

enum ReportType {
  STUDENT_REPORT_CARD
  CLASS_MASTER_SHEET
  FEE_SUMMARY
}

// ==========================================
// AUTH & USERS
// ==========================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      UserRole
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  admin         Admin?
  teacher       Teacher?
  student       Student?
  parent        Parent?
  announcements Announcement[]
  reportLogs    ReportDownloadLog[] // Back-relation for reports

  @@index([email])
}

model Admin {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?
}

model Teacher {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  phone        String?
  status       TeacherStatus @default(ACTIVE)
  departmentId String?
  department   Department?   @relation(fields: [departmentId], references: [id])

  subjectAssignments  TeacherSubjectClass[]
  transfersHistory    TeacherTransfer[]
  recordedAttendances Attendance[]          @relation("TeacherRecordedAttendances")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id                String        @id @default(uuid())
  userId            String        @unique
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName         String
  lastName          String
  gender            String
  admissionNumber   String        @unique
  currentGradeLevel Int // Grades 9, 10, 11, or 12
  currentStream     Stream        @default(GENERAL)
  status            StudentStatus @default(ACTIVE)
  dateOfBirth       DateTime?

  sectionId String?
  section   ClassSection? @relation(fields: [sectionId], references: [id])

  enrollments      StudentEnrollment[]
  parents          StudentParent[]
  attendanceLogs   AttendanceLog[]
  attendances      Attendance[]
  grades           Grade[]
  results          Result[]
  termSummaries    StudentTermSummary[]
  externalRecords  ExternalAcademicRecord[]
  transfers        StudentTransfer[]
  feePayments      FeePayment[]
  reportLogs       ReportDownloadLog[] // Back-relation for reports
  savedReportCards SavedReportCard[]   // Back-relation for saved PDFs

  @@index([currentGradeLevel, status])
}

model Parent {
  id        String  @id @default(uuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String?

  students StudentParent[]
}

model StudentParent {
  studentId    String
  parentId     String
  relationship String // e.g., "Mother", "Father", "Guardian"

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@id([studentId, parentId])
}

// ==========================================
// ACADEMICS & TIMETABLE
// ==========================================

model Department {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  teachers    Teacher[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model AcademicYear {
  id        String   @id @default(uuid())
  yearName  String   @unique // e.g., "2025-2026"
  startDate DateTime
  endDate   DateTime
  isCurrent Boolean  @default(false)

  terms                 Term[]
  enrollments           StudentEnrollment[]
  teacherSubjectClasses TeacherSubjectClass[]
  feeStructures         FeeStructure[]
}

model Term {
  id             String       @id @default(uuid())
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  termName       String // e.g., "Semester 1", "Term 2"
  startDate      DateTime
  endDate        DateTime
  isCurrent      Boolean      @default(false)

  attendanceLogs   AttendanceLog[]
  assessments      Assessment[]
  examinations     Examination[]
  summaries        StudentTermSummary[]
  reportLogs       ReportDownloadLog[] // Back-relation for reports
  savedReportCards SavedReportCard[]   // Back-relation for saved PDFs
}

model ClassSection {
  id          String @id @default(uuid())
  gradeLevel  Int // 9, 10, 11, or 12
  sectionName String // "A", "B", "C" OR "NS1", "NS2", "SS1", "SS2"
  stream      Stream @default(GENERAL)

  // Relations
  students              Student[]
  enrollments           StudentEnrollment[]
  teacherSubjectClasses TeacherSubjectClass[]
  attendanceLogs        AttendanceLog[]
  attendance            Attendance[]

  @@unique([gradeLevel, sectionName])
}

model StudentEnrollment {
  id              String          @id @default(uuid())
  studentId       String
  academicYearId  String
  classSectionId  String
  gradeLevel      Int
  stream          Stream          @default(NONE)
  promotionStatus PromotionStatus @default(PENDING)
  enrolledAt      DateTime        @default(now())

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  classSection ClassSection @relation(fields: [classSectionId], references: [id])

  @@unique([studentId, academicYearId])
  @@index([gradeLevel, stream])
}

model Subject {
  id          String  @id @default(uuid())
  name        String // e.g., "Mathematics"
  code        String  @unique // e.g., "MATH-09"
  description String?
  gradeLevel  Int

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  teacherSubjectClasses TeacherSubjectClass[]
  examinations          Examination[]
}

model TeacherSubjectClass {
  id             String @id @default(uuid())
  teacherId      String
  subjectId      String
  classSectionId String
  academicYearId String

  teacher      Teacher      @relation(fields: [teacherId], references: [id])
  subject      Subject      @relation(fields: [subjectId], references: [id])
  classSection ClassSection @relation(fields: [classSectionId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  timetables  Timetable[]
  assessments Assessment[]

  @@unique([teacherId, subjectId, classSectionId, academicYearId])
}

model Timetable {
  id                    String              @id @default(uuid())
  teacherSubjectClassId String
  teacherSubjectClass   TeacherSubjectClass @relation(fields: [teacherSubjectClassId], references: [id])
  dayOfWeek             Int // 1 (Mon) to 5 (Fri)
  periodNumber          Int
  startTime             String // "08:00"
  endTime               String // "08:45"
}

// ==========================================
// ATTENDANCE MANAGEMENT
// ==========================================

model AttendanceLog {
  id             String           @id @default(uuid())
  studentId      String
  termId         String
  classSectionId String?
  date           DateTime         @default(now())
  type           AttendanceType
  status         AttendanceStatus
  passStatus     HallPassStatus   @default(NONE)
  minutesOut     Int?

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term         Term          @relation(fields: [termId], references: [id])
  classSection ClassSection? @relation(fields: [classSectionId], references: [id])

  @@index([studentId, date])
}

model Attendance {
  id      String           @id @default(uuid())
  date    DateTime         @default(now()) @db.Date
  status  AttendanceStatus
  remarks String?

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  classSectionId String
  classSection   ClassSection @relation(fields: [classSectionId], references: [id], onDelete: Cascade)

  recordedById String
  recordedBy   Teacher @relation("TeacherRecordedAttendances", fields: [recordedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([studentId, classSectionId, date])
}

// ==========================================
// EVALUATION, EXAMS & GRADEBOOK
// ==========================================

model Assessment {
  id                    String         @id @default(uuid())
  teacherSubjectClassId String
  termId                String
  title                 String
  type                  AssessmentType
  weightPercentage      Float
  maxScore              Float          @default(100.0)

  teacherSubjectClass TeacherSubjectClass @relation(fields: [teacherSubjectClassId], references: [id])
  term                Term                @relation(fields: [termId], references: [id])
  grades              Grade[]
}

model Grade {
  id            String  @id @default(uuid())
  assessmentId  String
  studentId     String
  scoreObtained Float
  remarks       String?

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
}

model Examination {
  id         String   @id @default(uuid())
  title      String // e.g., "Mid-Term", "Final Exam"
  type       ExamType @default(FINAL)
  date       DateTime @db.Date
  totalMarks Float // e.g., 100.0

  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  results Result[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Result {
  id            String  @id @default(uuid())
  marksObtained Float
  grade         String? // e.g., "A", "B", "C", "F"
  remarks       String?

  examinationId String
  examination   Examination @relation(fields: [examinationId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([examinationId, studentId])
}

model GradingScale {
  id          String @id @default(uuid())
  letterGrade String @unique // e.g., "A+", "A", "B", "F"
  minScore    Float
  maxScore    Float
  gpaPoint    Float
}

model StudentTermSummary {
  id                 String          @id @default(uuid())
  studentId          String
  termId             String
  totalWeightedScore Float
  termGpa            Float
  promotionStatus    PromotionStatus @default(PENDING)

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id])

  @@unique([studentId, termId])
}

// ==========================================
// FEES & FINANCIAL MANAGEMENT
// ==========================================

model FeeStructure {
  id             String       @id @default(uuid())
  title          String // e.g., "Grade 9 Tuition Fee"
  amount         Float
  gradeLevel     Int // Target grade (9, 10, 11, or 12)
  dueDate        DateTime
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  payments FeePayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FeePayment {
  id             String        @id @default(uuid())
  feeStructureId String
  feeStructure   FeeStructure  @relation(fields: [feeStructureId], references: [id])
  studentId      String
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  amountPaid     Float
  paymentDate    DateTime      @default(now())
  paymentMethod  PaymentMethod
  receiptNumber  String        @unique
  status         FeeStatus     @default(PAID)
  remarks        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// ANNOUNCEMENTS & NOTIFICATIONS
// ==========================================

model Announcement {
  id          String    @id @default(uuid())
  title       String
  content     String
  targetRole  UserRole? // Nullable: targeting specific roles or everyone
  targetGrade Int? // Nullable: targeting specific grade level
  authorId    String
  author      User      @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// TRANSFERS & EXTERNAL RECORDS
// ==========================================

model ExternalAcademicRecord {
  id                 String @id @default(uuid())
  studentId          String
  previousSchoolName String
  gradeLevel         Int
  subjectName        String
  creditsEarned      Float
  letterGrade        String

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentTransfer {
  id                String       @id @default(uuid())
  studentId         String
  transferType      TransferType
  destinationSchool String?
  reason            String?
  transferDate      DateTime     @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model TeacherTransfer {
  id                String   @id @default(uuid())
  teacherId         String
  destinationSchool String
  reason            String?
  handoverNotes     String?
  transferDate      DateTime @default(now())

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

// ==========================================
// REPORTS & LOGS
// ==========================================

model ReportDownloadLog {
  id          String     @id @default(uuid())
  generatedBy String     // User ID of who generated it
  studentId   String?    // Nullable if it's a class/fee report
  termId      String?
  reportType  ReportType
  generatedAt DateTime   @default(now())

  user    User     @relation(fields: [generatedBy], references: [id], onDelete: Cascade)
  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term?    @relation(fields: [termId], references: [id], onDelete: Cascade)
}

model SavedReportCard {
  id         String   @id @default(uuid())
  studentId  String
  termId     String
  pdfUrl     String   // e.g., AWS S3 or Cloudinary URL
  createdAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  term    Term    @relation(fields: [termId], references: [id], onDelete: Cascade)

  @@unique([studentId, termId])
}